# Copy this file to .env before running Docker Compose.
POSTGRES_USER=bug_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=bug_classifier
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Internal Docker service addresses
DATABASE_URL=postgresql+asyncpg://bug_user:replace-with-a-long-random-password@postgres:5432/bug_classifier
REDIS_URL=redis://redis:6379/0

# Application configuration
MODEL_DIR=/app/saved_models/tfidf_model
TRAINING_DATA_PATH=/app/data/demo_bug_reports.csv
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_RETRAINING=false
SEED_DEMO_DATA=false
MAX_BATCH_SIZE=100
