# Triage Platform Runtime Configuration
# Copy this file to .env before running Docker Compose or local server.

# Database Credentials
POSTGRES_USER=bug_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=bug_classifier

# Monitoring & Admin Credentials
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-cryptographically-random-jwt-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Cache URLs
DATABASE_URL=sqlite+aiosqlite:///./bug_classifier.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://bug_user:replace-with-a-long-random-password@postgres:5432/bug_classifier
REDIS_URL=redis://localhost:6379/0

# Machine Learning & Triage Engine
MODEL_DIR=saved_models/tfidf_model
TRAINING_DATA_PATH=data/training_dataset.jsonl
CONFIDENCE_HIGH_THRESHOLD=0.25
CONFIDENCE_LOW_THRESHOLD=0.50
ENABLE_RETRAINING=true
SEED_DEMO_DATA=false

# CORS & Frontend Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# External Integrations (Optional)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
